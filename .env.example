# ===========================================================================
# HackAtlas — Environment Variables Template
# ===========================================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ===========================================================================

# ---------------------------------------------------------------------------
# DATABASE (Neon PostgreSQL)
# Get from: https://console.neon.tech → Your Project → Connection string
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# NEXTAUTH / AUTH.JS
# Generate AUTH_SECRET with: npx auth secret
# ---------------------------------------------------------------------------
AUTH_SECRET="your-auth-secret-here"

# ---------------------------------------------------------------------------
# GITHUB OAUTH
# Create at: https://github.com/settings/developers → OAuth Apps → New
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:3000/api/auth/callback/github
# ---------------------------------------------------------------------------
AUTH_GITHUB_ID="your-github-oauth-app-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-app-client-secret"

# ---------------------------------------------------------------------------
# APP URL
# ---------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# INGEST API & CRON
# Secret bearer token that protects POST /api/ingest and GET /api/ingest.
# Generate a secure value with: openssl rand -hex 32
# Usage for manual ingest: Authorization: Bearer <INGEST_SECRET>
# Usage for Vercel Cron:   Authorization: Bearer <CRON_SECRET>
# ---------------------------------------------------------------------------
INGEST_SECRET="your-ingest-secret-here"
CRON_SECRET="your-cron-secret-here"
